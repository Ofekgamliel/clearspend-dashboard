{
  "name": "clearspend-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/verify-production-build.mjs",
    "typecheck": "vue-tsc -b",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test test/*.test.ts",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --ignore-snapshots",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
